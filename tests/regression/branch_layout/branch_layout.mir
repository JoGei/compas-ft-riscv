--- |
  target triple = "riscv32-unknown-elf"
  define i32 @branch_layout(i32 %value) {
  entry:
    br label %condition_block
  condition_block:
    %condition = icmp ne i32 %value, 0
    br i1 %condition, label %nonzero, label %zero
  nonzero:
    %result = add i32 %value, 3
    ret i32 %result
  zero:
    ret i32 7
  }
...
---
name: branch_layout
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    liveins: $x1, $x10
    PseudoBR %bb.1

  bb.1.condition_block:
    successors: %bb.2, %bb.3
    liveins: $x1, $x10
    BNE $x10, $x0, %bb.2
    PseudoBR %bb.3

  bb.2.nonzero:
    liveins: $x1, $x10
    $x10 = ADDI $x10, 3
    PseudoRET implicit $x1, implicit $x10

  bb.3.zero:
    liveins: $x1
    $x10 = ADDI $x0, 7
    PseudoRET implicit $x1, implicit $x10
...
